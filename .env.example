# =============================================================================
# MaBuy Quantitative Trading Citadel — Environment Configuration Template
# =============================================================================
# Copy this file to .env and replace placeholder values with your actual configuration.
# NEVER commit your real .env file or private API keys to version control!
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. Binance USD-M Futures Credentials (Maker-First / Sub-Account Recommended)
# ─────────────────────────────────────────────────────────────────────────────
# Required for live trading execution and live account balance telemetry.
# Ensure your API key has "Enable Futures" permissions enabled.
# Restrict IP access on Binance to your production VPS / host IP for maximum security.
BINANCE_API_KEY=your_binance_futures_api_key_here
BINANCE_API_SECRET=your_binance_futures_api_secret_here

# Real Binance orders are OFF unless this is set to true. Keep it false: the trading code is unvalidated.
REAL_TRADING_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# 2. Telegram Bot Infrastructure (@BotFather)
# ─────────────────────────────────────────────────────────────────────────────
# Primary bot token from @BotFather for alerts, interactive cockpit, and trade reporting
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Master Admin Telegram User ID (numeric, e.g. 123456789) for privileged commands
TELEGRAM_ADMIN_CHAT_ID=your_telegram_user_id_here

# Channel ID for public or VIP signal broadcasting (optional, e.g. @your_channel or -100xxx)
TELEGRAM_CHANNEL_ID=

# ─────────────────────────────────────────────────────────────────────────────
# 3. Monetization & Subscriptions (@CryptoBot API)
# ─────────────────────────────────────────────────────────────────────────────
# Crypto Pay API token from @CryptoBot for accepting USDT/TON payments for PRO tier
CRYPTO_PAY_API_KEY=your_cryptopay_api_token_here

# ─────────────────────────────────────────────────────────────────────────────
# 4. Neural Copilot & LLM Reasoning (Astra / OpenAI API)
# ─────────────────────────────────────────────────────────────────────────────
# API key for MaIA Market Copilot, news sentiment extraction, and narrative intelligence
OPENAI_API_KEY=your_llm_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Web chat MaIA (Vercel function api/maia.js): Groq key, server-side only
GROQ_API_KEY=
# Optional: other sites allowed to call /api/maia (comma-separated); empty = same-origin only
ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# 5. Mobile PWA & REST API Gateway Security
# ─────────────────────────────────────────────────────────────────────────────
# Bearer token required by Mobile PWA client and external REST clients
# Leave empty in local development for permissive mode, or set a secure token for production
MABUY_MOBILE_AUTH_TOKEN=generate_a_random_32_character_hex_secret_here

# Fast API Binding & Networking
MABUY_HOST=0.0.0.0
MABUY_PORT=8000

# ─────────────────────────────────────────────────────────────────────────────
# 6. Database & Persistence
# ─────────────────────────────────────────────────────────────────────────────
# SQLite production database path (WAL mode automatically managed)
DATABASE_PATH=data/mabuy_prod.db

# ─────────────────────────────────────────────────────────────────────────────
# 7. Institutional Quantitative Risk Parameters
# ─────────────────────────────────────────────────────────────────────────────
# High-Conviction Sniper entry confidence threshold (0.75 = 75.0% required)
MIN_CONFIDENCE_THRESHOLD=0.75

# Fractional Kelly sizing multiplier (0.25 = Quarter-Kelly standard)
RISK_FRACTION_KELLY=0.25

# Hard stop-loss ATR multiplier floor (min 1.8% to prevent random market noise stops)
HARD_STOP_LOSS_FLOOR_PCT=0.018

# Max leverage allowed across any single position (enforced at order routing)
MAX_POSITION_LEVERAGE=3.0

# Dynamic circuit breaker max portfolio drawdown before 4-hour cooling-off (3.5%)
MAX_DRAWDOWN_CIRCUIT_BREAKER=0.035

# Trailing Profit Lock tiers (Percentage moves)
# Tier 1: +1.0% move -> Lock Break-Even (+0.1% net of fees)
# Tier 2: +1.8% move -> Lock +0.8% guaranteed profit
# Tier 3: +2.5% move -> Lock +1.5% guaranteed profit
# Tier 4: +3.2% move -> Market Take-Profit
TRAILING_TIER1_TRIGGER=0.010
TRAILING_TIER1_LOCK=0.001
TRAILING_TIER2_TRIGGER=0.018
TRAILING_TIER2_LOCK=0.008
TRAILING_TIER3_TRIGGER=0.025
TRAILING_TIER3_LOCK=0.015
TRAILING_TIER4_TP=0.032

# ─────────────────────────────────────────────────────────────────────────────
# 8. Operational Telemetry & Logging
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/daemon.log
